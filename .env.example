# PizzaDAO Onboarding - Environment Variables
# Copy this file to .env.local and fill in the values

# OpenAI API Key (for name generation)
OPENAI_API_KEY=sk-...

# TMDB API Key (for movie lookups)
TMDB_API_KEY=

# Google Sheets Integration
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/xxx/exec
GOOGLE_SHEETS_SHARED_SECRET=
# Service account key JSON for the Sheets API (hyperlinks, attendance, webhooks, task claims).
# Without it, Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS) are used.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional sheet ID overrides (e.g. point a preview/staging deploy at sheet copies).
# Defaults live in app/lib/sheets/config.ts.
# MEMBERS_SHEET_ID=
# CREW_MAPPINGS_SHEET_ID=
# COMMUNITY_CALL_SHEET_ID=
# POAP_WHITELIST_SHEET_ID=
# NFT_CONTRACTS_SHEET_ID=
# MANUALS_SHEET_ID=
# DISCORD_WEBHOOKS_SHEET_ID=
# ANNOUNCE_SHEET_ID=

# Google Maps API Key (for city autocomplete)
GOOGLE_MAPS_API_KEY=

# Discord OAuth2 Credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/discord/callback

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Discord Bot (for role management)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Claim Password (for manual member ID claims)
CLAIM_PASSWORD=

# /announce Community Call trigger - server-only, used by /api/announce.
# Posts to Discord straight from the server (no Apps Script). Uses DISCORD_BOT_TOKEN
# unless ANNOUNCE_DISCORD_WEBHOOK_URL is set (webhook takes precedence).
# ANNOUNCE_DISCORD_CHANNEL_ID=812143244149915679
# ANNOUNCE_DISCORD_WEBHOOK_URL=
# Optional Telegram cross-post (both required to enable):
# ANNOUNCE_TELEGRAM_BOT_TOKEN=
# ANNOUNCE_TELEGRAM_CHAT_IDS=
# Time zone for Last Sent / Last Error stamps and the "upcoming Sunday" label.
# ANNOUNCE_TIMEZONE=America/New_York
# After the Discord post, the Apps Script SecretService web app is called
# (action "announce", Discord posts disabled) to start the Discord event, post
# the tweet and take voice attendance. Both required, else that step is reported failed.
ANNOUNCE_WEBAPP_URL=
ANNOUNCE_PASSWORD=
# Who may fire it: comma-separated Discord role IDs. Falls back to ADMIN_ROLE_IDS;
# if neither is set, a temporary hard-coded user allowlist is used.
# ANNOUNCE_ROLE_IDS=
# ADMIN_ROLE_IDS=

# Telegram account linking (calzone-93434) - optional; if either is unset the
# "Link Telegram" button is hidden. The bot's domain must be set in BotFather:
#   /setdomain -> select the bot -> app.pizzadao.org
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Call follow-ups (metalhead-followups). Messages go through the same login bot above.
# Shared secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token on every webhook call
# (random string, 1-256 chars of A-Z a-z 0-9 _ -). Register once against production only:
#   node scripts/telegram-set-webhook.mjs https://app.pizzadao.org/api/telegram/webhook --apply
TELEGRAM_WEBHOOK_SECRET=
# Kill switch. Set to "off" to stop all follow-up sending whatever the admin setting says.
# Sending is also OFF by default in the admin settings (Follow-ups > Sending follow-up messages).
# FOLLOWUPS_SEND_ENABLED=
# Optional: model for the follow-up extraction pass (default: the call summary model).
# FOLLOWUP_MODEL=

# Support tickets (buffalo-96244) - optional. Channel name looked up in the
# Discord webhooks sheet for new-ticket pings (default "Support").
# SUPPORT_DISCORD_CHANNEL=Support

# Pizza Trainee nicknames (anchovy-52918). Ships disabled: the cron dry-runs until
# TRAINEE_NICK_ENABLED=true. TRAINEE_NICK_SINCE (ISO time, set to go-live) is
# required: only members who join on/after it are touched; without it nothing runs.
TRAINEE_NICK_ENABLED=
TRAINEE_NICK_SINCE=
# TRAINEE_NICK_MAX_PER_RUN=50
# TRAINEE_NICK_MIN_SIGNED_UP=100
# Optional: Pizza Noob role id (otherwise found by name)
# PIZZA_NOOB_ROLE_ID=
# Optional: Box Mafia role id (otherwise found by name) and Rare Pizzas Box buy link
# (default OpenSea; set empty to hide the dashboard suggestion card)
# BOX_MAFIA_ROLE_ID=
# NEXT_PUBLIC_BOX_PURCHASE_URL=https://opensea.io/collection/rare-pizzas-box

# Disavow list (plans/disavow-list.md). Off unless "true". Needs the 20261027000000_disavow_list migration applied first.
DISAVOW_ENABLED=

# Call Slices (plans/call-attendance-nfts.md): attendance NFTs on Base, minted by the server.
# Needs the 20261030000000_call_slices migration applied first. Ships OFF: nothing mints
# until SLICES_ENABLED=true (claims still queue). Never commit values; set them in Vercel
# (SLICES_MINTER_PRIVATE_KEY as Sensitive, Production only).
SLICES_ENABLED=
SLICES_CONTRACT_ADDRESS=
SLICES_MINTER_PRIVATE_KEY=
BASE_RPC_URL=
# Base only in production. 84532 (Base Sepolia) is honored ONLY with SLICES_ALLOW_NON_PROD=true (local QA).
# SLICES_CHAIN_ID=8453
# Max mints per rolling 24h (default 1000)
# SLICES_DAILY_CAP=1000
# Skip a mint run while maxFeePerGas is above this many gwei (default 0.5)
# SLICES_MAX_GAS_GWEI=0.5
# Alert (PEP_ADMIN_LOG_CHANNEL_ID) and pause below this minter balance in ETH (default 0.003)
# SLICES_MIN_BALANCE_ETH=0.003
# Minting only runs when VERCEL_ENV=production (previews share the prod DB). Local dev ONLY, against a
# local/forked DB and a testnet contract: SLICES_ALLOW_NON_PROD=true
# SLICES_ALLOW_NON_PROD=
