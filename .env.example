# PizzaDAO Onboarding - Environment Variables
# Copy this file to .env.local and fill in the values

# OpenAI API Key (for name generation)
OPENAI_API_KEY=sk-...

# TMDB API Key (for movie lookups)
TMDB_API_KEY=

# Google Sheets Integration
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/xxx/exec
GOOGLE_SHEETS_SHARED_SECRET=
# Service account key JSON for the Sheets API (hyperlinks, attendance, webhooks, task claims).
# Without it, Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS) are used.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional sheet ID overrides (e.g. point a preview/staging deploy at sheet copies).
# Defaults live in app/lib/sheets/config.ts.
# MEMBERS_SHEET_ID=
# CREW_MAPPINGS_SHEET_ID=
# COMMUNITY_CALL_SHEET_ID=
# POAP_WHITELIST_SHEET_ID=
# NFT_CONTRACTS_SHEET_ID=
# MANUALS_SHEET_ID=
# DISCORD_WEBHOOKS_SHEET_ID=
# ANNOUNCE_SHEET_ID=

# Google Maps API Key (for city autocomplete)
GOOGLE_MAPS_API_KEY=

# Discord OAuth2 Credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/discord/callback

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Discord Bot (for role management)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Claim Password (for manual member ID claims)
CLAIM_PASSWORD=

# /announce Community Call trigger - server-only, used by /api/announce.
# Posts to Discord straight from the server (no Apps Script). Uses DISCORD_BOT_TOKEN
# unless ANNOUNCE_DISCORD_WEBHOOK_URL is set (webhook takes precedence).
# ANNOUNCE_DISCORD_CHANNEL_ID=812143244149915679
# ANNOUNCE_DISCORD_WEBHOOK_URL=
# Optional Telegram cross-post (both required to enable):
# ANNOUNCE_TELEGRAM_BOT_TOKEN=
# ANNOUNCE_TELEGRAM_CHAT_IDS=
# Time zone for Last Sent / Last Error stamps and the "upcoming Sunday" label.
# ANNOUNCE_TIMEZONE=America/New_York
# Who may fire it: comma-separated Discord role IDs. Falls back to ADMIN_ROLE_IDS;
# if neither is set, a temporary hard-coded user allowlist is used.
# ANNOUNCE_ROLE_IDS=
# ADMIN_ROLE_IDS=

# Telegram account linking (calzone-93434) - optional; if either is unset the
# "Link Telegram" button is hidden. The bot's domain must be set in BotFather:
#   /setdomain -> select the bot -> app.pizzadao.org
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Support tickets (buffalo-96244) - optional. Channel name looked up in the
# Discord webhooks sheet for new-ticket pings (default "Support").
# SUPPORT_DISCORD_CHANNEL=Support
